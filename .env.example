DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tournaments?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
# Delay after endsAt before the final snapshot runs, so in-flight bets for the last moments can land.
FINALIZE_GRACE_MS=5000

# Optional tuning (defaults shown)
# FINALIZE_ATTEMPTS=10
# FINALIZE_BACKOFF_MS=5000
# FINALIZE_TIMEOUT_MS=60000
# FINALIZE_SWEEP_EVERY_MS=60000
# FINALIZE_SWEEP_BATCH_SIZE=100
# LEADERBOARD_TTL_AFTER_END_SECONDS=604800
